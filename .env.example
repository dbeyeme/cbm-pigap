# CBM-PIGAP — variables d'environnement (exemple)
# Copier vers .env à la racine ou dans backend/ — ne jamais committer .env

# PostgreSQL / PostGIS (docker-compose)
POSTGRES_USER=pigap
POSTGRES_PASSWORD=pigap_dev_change_me
POSTGRES_DB=pigap
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+asyncpg://pigap:pigap_dev_change_me@localhost:5432/pigap
APP_ENV=development
LOG_LEVEL=INFO
# JWT — générer une valeur aléatoire forte avant tout déploiement
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# M2 — intervalle d'envoi GPS mobile (minutes)
GPS_INTERVAL_MINUTES=5

# ADR-005 — AIS open data filtré ZEE Gabon
AIS_ENABLED=true
AIS_OPENWATERS_URL=https://ais.openwaters.io
AIS_POLL_SECONDS=60
AIS_COLLECT_SECONDS=25
# false = pas de faux navires ; mets true seulement pour tester l’UI
AIS_DEMO_WHEN_EMPTY=false
# Clé GRATUITE : https://aisstream.io → Account → API Keys (obligatoire pour du vrai AIS Gabon)
AISSTREAM_API_KEY=
# Marge côtière (degrés) ajoutée à la ZEE pour inclure quais et estuaires
AIS_COASTAL_BUFFER_DEG=0.12
# Conservation d'une position sans nouveau message (minutes) : en route / immobile
AIS_TTL_MOVING_MIN=30
AIS_TTL_MOORED_MIN=180
# Récepteur AIS local (AIS-catcher, dAISy…) → POST /api/v1/ais/ingest
# Générer : openssl rand -hex 24 — vide = ingestion désactivée
AIS_INGEST_KEY=
# Référentiel ports (optionnel) — défaut data/open-data/gabon/ports.json
# AIS_PORTS_PATH=

# --- Production / staging ---
# Backend (Railway) : DATABASE_URL fourni par le plugin Postgres ;
# convertir en postgresql+asyncpg:// si besoin. PORT injecté par Railway.
# APP_ENV=production
# JWT_SECRET=<openssl rand -hex 32>

# Frontend web (Vercel)
# VITE_API_URL=https://<backend>.up.railway.app

# Abonnements / Mobile Money (docs/modele-economique.md)
# demo = confirmer-demo ; live = PawaPay AIRTEL_GAB
MOBILE_MONEY_MODE=demo
# MOBILE_MONEY_WEBHOOK_SECRET=
# Météo-marine (Open-Meteo, CC BY 4.0, sans clé) — ADR-008
METEO_ENABLED=true
METEO_CACHE_MINUTES=30
# Seuils de risque pirogues (houle m, rafales nœuds, courant nœuds)
METEO_HOULE_ORANGE_M=1.8
METEO_HOULE_ROUGE_M=2.5
METEO_RAFALES_ORANGE_KN=22
METEO_RAFALES_ROUGE_KN=30
METEO_COURANT_ORANGE_KN=1.2
METEO_COURANT_ROUGE_KN=2.0
# Quotas : pression à 75 %, surexploitation à 90 %
METEO_QUOTA_PRESSION=0.75
METEO_QUOTA_SUREXPLOITATION=0.9

# PawaPay Gabon (AIRTEL_GAB / XAF) — jamais committer le token réel
# PAWAPAY_API_TOKEN=
# PAWAPAY_BASE_URL=https://api.pawapay.io
# Callback dashboard PawaPay :
#   https://<API_HOST>/api/v1/abonnements/webhook/pawapay/deposits
# true = bloque captures/GPS pêcheur sans abonnement (Phase 4)
ABONNEMENT_ENFORCE=false
