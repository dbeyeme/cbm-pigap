# CBM-PIGAP — variables d'environnement (exemple)
# Copier vers .env à la racine ou dans backend/ — ne jamais committer .env

# PostgreSQL / PostGIS (docker-compose)
POSTGRES_USER=pigap
POSTGRES_PASSWORD=pigap_dev_change_me
POSTGRES_DB=pigap
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+asyncpg://pigap:pigap_dev_change_me@localhost:5432/pigap
APP_ENV=development
LOG_LEVEL=INFO
# JWT — générer une valeur aléatoire forte avant tout déploiement
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# M2 — intervalle d'envoi GPS mobile (minutes)
GPS_INTERVAL_MINUTES=5

# --- Production / staging ---
# Backend (Railway) : DATABASE_URL fourni par le plugin Postgres ;
# convertir en postgresql+asyncpg:// si besoin. PORT injecté par Railway.
# APP_ENV=production
# JWT_SECRET=<openssl rand -hex 32>

# Frontend web (Vercel)
# VITE_API_URL=https://<backend>.up.railway.app
