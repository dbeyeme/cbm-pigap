# Variables de construction de l'application mobile CBM-PIGAP.
# Copier ce fichier en `.env` et renseigner les valeurs. Elles sont figées dans
# le paquet au moment de la compilation : n'y mettre aucun secret.

# Adresse du serveur CBM-PIGAP. En https pour toute construction de diffusion
# (une adresse en http est refusée, sauf avec PIGAP_ESSAI_LOCAL=1).
EXPO_PUBLIC_API_URL=https://api.exemple.ga

# Origine publique du portail, inscrite dans le QR de la carte professionnelle
# (`<origine>/verif/licence/<numéro>`). Facultatif : par défaut, la même valeur
# que le réglage `public_web_url` du serveur.
# EXPO_PUBLIC_PORTAIL_URL=https://portail.exemple.ga

# Aides de démonstration (comptes d'essai proposés à la connexion, parcours
# d'exemple et relevé rapide sur l'écran GPS, mot de passe proposé à la création
# d'un dossier). Présentes par défaut ; mettre `false` pour une construction
# destinée au terrain.
# EXPO_PUBLIC_MODE_DEMO=false

# Fond de carte de l'écran GPS (facultatif) : modèle d'adresse des tuiles avec
# {s}, {z}, {x}, {y}, et mention d'attribution affichée sur la carte.
# EXPO_PUBLIC_TILE_URL_TEMPLATE=
# EXPO_PUBLIC_TILE_ATTRIBUTION=

# Clé Google Maps pour Android (facultatif). Sans elle, la carte est assemblée
# par tuiles.
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
